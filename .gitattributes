# Source files that must stay LF on every platform.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.md text eol=lf

# Windows scripts should be CRLF for cmd.exe / PowerShell compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
