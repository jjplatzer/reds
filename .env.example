# ─── Solace / SWIM connection ───────────────────────────────────────────────────────
# ─── Replace dots with your credentials ─────────────────────────────────────────────
#
# These credentials are only needed if USE_PUBLIC_SERVER=false.

SMES_JMS_URL=...
SMES_VPN=...
SCDS_USERNAME=...
SCDS_PASSWORD=...
SMES_QUEUE=...

# Server-side user inactivity timeout shared by SMES/ASDE-X, TAIS/STARS, APTC and ITWS.
# Default: 600 seconds (10 minutes). Set to 1800 for 30 minutes, or 0 to disable.
REDS_CLIENT_INACTIVITY_SECONDS=600

# ─── TAIS / STARS airborne track feed ───────────────────────────────────────────
# Keep the SWIFT TAIS subscription server-side filtered to the same TRACON(s).
TAIS_JMS_URL=...
TAIS_VPN=...
TAIS_QUEUE=...
TAIS_FACILITIES=N90
TAIS_WS_HOST=127.0.0.1
TAIS_WS_PORT=8081
TAIS_WS_PATH=/tais/ws
TAIS_HEALTH_PATH=/tais/healthz
TAIS_WS_MAX_CLIENTS=64
TAIS_WS_PENDING_MAX=4096

# Optional desktop TAIS endpoint override. STARS/TAIS does not require a token.
# TAIS_WS_URL=wss://reds-stdds-live.jjplatzer.com/tais/ws

# ─── TFMData / Airport Configuration (APTC) ──────────────────────────────────
# Separate TFMData Flow Information subscription, filtered to Airport Configuration.
# Shares SCDS_USERNAME / SCDS_PASSWORD above. Empty local filters accept all reports.
APTC_JMS_URL=...
APTC_VPN=...
APTC_QUEUE=...
APTC_FACILITIES=
APTC_AIRPORTS=
APTC_WS_HOST=127.0.0.1
APTC_WS_PORT=8083
APTC_WS_PATH=/aptc/ws
APTC_HEALTH_PATH=/aptc/healthz
APTC_SNAPSHOT_PATH=/aptc/configurations

# Optional desktop endpoint overrides. STARS GI text uses the public APTC feed
# when USE_PUBLIC_SERVER=true and the local port above otherwise.
# APTC_WS_URL=wss://reds-stdds-live.jjplatzer.com/aptc/ws
# REDS_ATIS_API_BASE_URL=https://atis.info/api

# ─── ITWS / Precipitation TRACON (product 9850) ──────────────────────────────
# Separate ITWS subscription. Shares SCDS_USERNAME / SCDS_PASSWORD above.
# Empty local site/source filters accept all reports; ALL also accepts all.
ITWS_JMS_URL=...
ITWS_VPN=...
ITWS_QUEUE=...
ITWS_SITES=
ITWS_SOURCES=
ITWS_WS_HOST=127.0.0.1
ITWS_WS_PORT=8084
ITWS_WS_PATH=/itws/ws
ITWS_HEALTH_PATH=/itws/healthz
ITWS_SNAPSHOT_PATH=/itws/products
ITWS_WS_MAX_CLIENTS=64
ITWS_WS_PENDING_MAX=128
ITWS_WS_QUEUE_BYTES=8388608
ITWS_MAX_PRODUCTS=256
# Retained history budget per process (encoded JSON bytes); 0 disables retention.
ITWS_HISTORY_MAX_BYTES=67108864
ITWS_MAX_BYTES=33554432
ITWS_STATS_INTERVAL_MS=30000
ITWS_RECONNECT_INITIAL_MS=5000
ITWS_RECONNECT_MAX_MS=60000
# HTTP snapshots and WebSocket connections accept ?site=I90 (or comma-separated sites).
# Add history=1 to include saved pictures in the initial snapshot.
# Optional desktop endpoint override; {tracon} expands to the selected TRACON in lowercase.
# ITWS_WS_URL=wss://reds-stdds-live.jjplatzer.com/itws/{tracon}/ws

# ─── SFDPS / ERAM feeds ──────────────────────────────────────────────────────
# Four independent SWIFT subscriptions feed one server/sfdps process.
# Shared Solace connection values may be overridden per subscription using
# SFDPS_<FLIGHT|AIRSPACE|GENERAL|STATUS>_JMS_URL / _VPN.
SFDPS_JMS_URL=...
SFDPS_VPN=...
SFDPS_FLIGHT_QUEUE=...
SFDPS_AIRSPACE_QUEUE=...
SFDPS_GENERAL_QUEUE=...
SFDPS_STATUS_QUEUE=...
SFDPS_FACILITIES=ZNY
SFDPS_WS_HOST=127.0.0.1
SFDPS_WS_PORT=8082
SFDPS_WS_PATH=/sfdps/ws
SFDPS_HEALTH_PATH=/sfdps/healthz
SFDPS_WS_MAX_CLIENTS=64
SFDPS_WS_PENDING_MAX=8192
SFDPS_MAX_BYTES=33554432
SFDPS_PRINT_STATS=true
SFDPS_STATS_INTERVAL_MS=30000
SFDPS_RECONNECT_INITIAL_MS=5000
SFDPS_RECONNECT_MAX_MS=60000
SFDPS_GENERAL_HISTORY=256

# Optional server-side authentication for SMES/SFDPS only (not STARS/TAIS).
# REDS_WS_TOKEN=...
SFDPS_TERMINAL_RETENTION_MS=1800000
SFDPS_DROPPED_TRACK_RETENTION_MS=1800000
SFDPS_IDLE_RETENTION_MS=86400000
SFDPS_STORE_SWEEP_MS=60000

# If true, REDS uses the public REDS live server instead of the credentials above.
# If omitted entirely, REDS defaults to USE_PUBLIC_SERVER=true.
USE_PUBLIC_SERVER=true

# Optional playback API override for local server testing.
# If omitted, REDS uses the public playback API when USE_PUBLIC_SERVER=true.
# PLAYBACK_BASE_URL=http://localhost:8080/playback
